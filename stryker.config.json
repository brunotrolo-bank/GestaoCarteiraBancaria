{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run -c vitest.stryker.config.ts --bail=1"
  },
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 6,
  "timeoutMS": 90000,
  "tsconfigFile": "tsconfig.stryker-ausente.json",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignorePatterns": [
    "reports",
    ".stryker-tmp",
    "docs",
    "frontend",
    "test-results",
    "coverage",
    "e2e",
    "planos",
    "node_modules/.cache"
  ]
}